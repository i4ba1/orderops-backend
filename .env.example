# Local demonstration values only. Docker Compose reads these explicitly.
ORDEROPS_POSTGRES_PORT=5433
ORDEROPS_POSTGRES_ADMIN_PASSWORD=postgres-local-only
ORDEROPS_DATABASE_PASSWORD=orders-local-only
FULFILLMENT_DATABASE_PASSWORD=fulfillment-local-only
ORDEROPS_OPERATOR_PASSWORD=operator-local-only
ORDEROPS_VIEWER_PASSWORD=viewer-local-only
# Built from the separate sibling project using compose.frontend-build.yaml.
ORDEROPS_FRONTEND_IMAGE=orderops-frontend:local
